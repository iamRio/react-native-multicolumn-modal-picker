{
  "name": "react-native-multicolumn-modal-picker",
  "version": "1.2.0",
  "description": "A highly customizable multi-column modal picker for React Native (Android, iOS, and Web).",
  "license": "MIT",
  "author": "Marcos A. Del Río Rodríguez <marcosdelrio.dev@gmail.com>",
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/rio_fores"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/rio_fores"
    }
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamRio/react-native-multicolumn-modal-picker.git"
  },
  "homepage": "https://github.com/iamRio/react-native-multicolumn-modal-picker",
  "bugs": {
    "url": "https://github.com/iamRio/react-native-multicolumn-modal-picker/issues"
  },
  "keywords": [
    "react-native",
    "react native",
    "react-native-picker",
    "react-native-select",
    "picker",
    "selector",
    "select",
    "modal-picker",
    "modal-selector",
    "ios-picker",
    "ios-selector",
    "android-picker",
    "android-selector",
    "web-picker",
    "web-selector",
    "multi-column",
    "multicolumn",
    "multi-column-picker",
    "multi-column-selector",
    "multiple-picker",
    "multiple-selector",
    "wheel-picker",
    "wheel-selector",
    "custom-picker",
    "customizable-picker",
    "searchable-picker",
    "search-picker",
    "typescript",
    "picker-with-search",
    "picker-with-search-bar",
    "modal-picker-with-search",
    "modal-picker-with-search-bar",
    "multi-column-picker-with-search",
    "multi-column-search-picker",
    "searchable-modal-picker"
  ],
  "scripts": {
    "format": "npx --yes prettier --write .",
    "format:check": "npx --yes prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npx --yes oxlint src",
    "validate": "npm run format && npm run typecheck && npm run lint",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "fores-play:local:prepare": "npm --prefix ../fores-play run package:local:install",
    "fores-play:local:start": "npm run fores-play:local:prepare && npm --prefix ../fores-play start",
    "fores-play:local:web": "npm run fores-play:local:prepare && npm --prefix ../fores-play run web",
    "fores-play:local:android": "npm run fores-play:local:prepare && npm --prefix ../fores-play run prebuild:android && npm --prefix ../fores-play run android",
    "fores-play:local:ios": "npm run fores-play:local:prepare && npm --prefix ../fores-play run ios"
  },
  "peerDependencies": {
    "@react-native-picker/picker": ">=2.4.10",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "react-native": ">=0.72.10",
    "react-native-safe-area-context": ">=4.6.3",
    "react-native-web": ">=0.19.0"
  },
  "peerDependenciesMeta": {
    "@react-native-picker/picker": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-picker/picker": "^2.11.4",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "typescript": "^7.0.2"
  }
}
