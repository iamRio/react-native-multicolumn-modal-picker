{
  "name": "react-native-multicolumn-modal-picker",
  "version": "1.1.2",
  "description": "A customizable multi-column modal picker for React Native iOS, supporting up to 3 selection columns.",
  "license": "MIT",
  "author": "Marcos A. Del Río Rodríguez <marcosdelrio.dev@email.com>",
  "type": "commonjs",
  "sideEffects": false,
  "main": "dist/index.js",
  "react-native": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamRio/react-native-multicolumn-modal-picker.git"
  },
  "homepage": "https://github.com/iamRio/react-native-multicolumn-modal-picker",
  "bugs": {
    "url": "https://github.com/iamRio/react-native-multicolumn-modal-picker/issues"
  },
  "keywords": [
    "react-native",
    "react native",
    "react-native-picker",
    "react-native-select",
    "picker",
    "selector",
    "select",
    "modal-picker",
    "modal-selector",
    "ios-picker",
    "ios-selector",
    "multi-column",
    "multicolumn",
    "multi-column-picker",
    "multi-column-selector",
    "multiple-picker",
    "multiple-selector",
    "wheel-picker",
    "wheel-selector",
    "custom-picker",
    "customizable-picker",
    "searchable-picker",
    "search-picker",
    "typescript",
    "picker-with-search",
    "picker-with-search-bar",
    "modal-picker-with-search",
    "modal-picker-with-search-bar",
    "multi-column-picker-with-search",
    "multi-column-search-picker",
    "searchable-modal-picker"
  ],
  "scripts": {
    "format": "npx --yes prettier --write .",
    "format:check": "npx --yes prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npx --yes oxlint src",
    "validate": "npm run format:check && npm run typecheck && npm run lint",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "example:local": "npm run build && npm pack && npm install --prefix example-app ./react-native-multicolumn-modal-picker-1.1.2.tgz --no-save --package-lock=false --ignore-scripts && npm --prefix example-app start",
    "example:restore": "npm install --prefix example-app --ignore-scripts"
  },
  "dependencies": {},
  "peerDependencies": {
    "@react-native-picker/picker": ">=2.4.10",
    "react": ">=18.2.0",
    "react-native": ">=0.72.10",
    "react-native-safe-area-context": ">=4.6.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "typescript": "^7.0.2"
  }
}
